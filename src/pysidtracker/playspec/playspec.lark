// playspec: a SID playroutine as synchronous extended finite state machines
// over memory-mapped cells. LALR(1).

start: _item*

_item: spec_decl | layout | const | cell | machine | proc | schedule
     | invariant | assume | override | extend | patch | drop
     | event | _object | record | view | table | output

spec_decl: "spec" NAME ("extends" NAME)? ";"
layout: "layout" "{" lfield* "}"
lfield: NAME ("," NAME)* ":" LKIND ";"
LKIND: "addr" | "byte" | "flag" | "list"
const: "const" NAME "=" expr ";"

cell: "cell" NAME ":" ctype "@" place (ATTR | notes)* [bits] ";"
bits: "{" bfield ("," bfield)* "}"
bfield: NAME ":" expr [".." expr]
notes: "notes" "(" NOTEPART "," expr ")"
NOTEPART: "lo" | "hi" | "word"
ctype: TYPE ("[" expr "]")?
place: expr                    -> at
     | "(" expr [":" expr] "," expr ")"   -> split
ATTR: "ro" | "out" | "operand" | "scratch" | "latched" | "volatile" | "per_proc"

machine: "machine" NAME ("[" NAME "in" expr ".." expr "]")? "{" _mitem* "}"
_mitem: cell | signal | control | proc | step | _object | record
signal: "signal" NAME ":" TYPE "=" expr ";"
control: "control" NAME ("on" NAME "mask" expr)? "{" state ("," state)* "}"
state: NAME ("=" expr)?
step: "step" block

// Derivation: a spec that extends a base restates only what differs.
override: "override" (const | cell | machine | proc | schedule | invariant
                     | signal | control | step)
extend: "extend" "machine" NAME "{" (_mitem | override | patch | drop)* "}"
patch: "patch" NAME "{" edit+ "}"
edit: EDITOP NAME eblock
eblock: "{" _stmt* "}"
EDITOP: "replace" | "before" | "after"
drop: "drop" NAME ("," NAME)* ";"

event: "event" NAME ":" NAME ";"

_object: counter | owner | accum | cursor | handler | latch
latch: "latch" lval ASSIGNOP expr "on" events ["when" expr] ";"
handler: "handler" NAME "on" events block
counter: "counter" NAME ":" NAME "{" _cclause* "}"
_cclause: c_on | c_wrap | c_reload
c_on: "on" events (ASSIGNOP expr | "reset") ";"
events: NAME ("," NAME)*
c_wrap: "wrap" ["at" expr] ["when" expr] ["->" NAME] ";"
c_reload: "reload" expr ";"

accum: "accum" NAME ":" NAME "{" _aclause* "}"
_aclause: a_step | a_dir | a_on
a_step: "step" expr ";"
a_dir: "dir" NAME ";"
a_on: "on" events (a_ramp | a_tri | a_flip) ["->" NAME] ";"
a_ramp: "ramp" ["to" expr "then" "stop"]
a_tri: "triangle"
a_flip: "flip"

owner: "owner" NAME ":" NAME "{" _oclause* "}"
_oclause: o_id | o_none | o_on
o_id: "id" expr ";"
o_none: "none" expr ";"
o_on: "on" events "claim" ["when" expr] ";"   -> o_claim
    | "on" events "release" ["when" expr] ";" -> o_release

w_table: "table" "@" expr ("," expr)* [w_width] ";"
w_width: "width" expr
w_pos: "pos" NAME [k_last] ";"
w_count: "count" NAME ";"
w_values: "values" NAME ("," NAME)* ";"
w_on: "on" events "step" ";"   -> w_step
    | "on" events "reset" ";" -> w_reset
w_start: "start" expr ";"
w_then: "then" wset ("," wset)*
wset: NAME ["." NAME] "=" expr ["if" expr] ["when" expr]

cursor: "cursor" NAME "{" _uclause* "}"
_uclause: w_table | k_stream | w_pos | w_count | w_values | u_ret | u_run | k_run | u_adv | w_on
        | u_settle | k_next | w_start | c_wrap | u_match | k_field
k_stream: "stream" "@" expr ("grammar" gsel ("," gsel)*)? ";"
k_next: "on" events "next" ";"
u_ret: "ret" NAME ";"
u_run: "run" NAME ";"
u_adv: "advance" ADVANCE ";"
ADVANCE: "pre" | "post"
u_settle: "on" events "settle" ";"
u_match: "match" NAME "{" urow* "}"
urow: mpat ("," mpat)* ["if" expr] ["when" expr] "=>" u_act [w_then] ";"
    | "_" "=>" u_act [w_then] ";"    -> udefault
u_act: "value" "(" [wset ("," wset)*] ")" ["take" expr]  -> u_value
     | "hold" "(" expr ")"                             -> u_hold
     | "sweep" "(" wset ("," wset)* ")"                -> a_sweep
     | "jump" "(" expr ")" ["hold" expr ".." expr] ["as" expr] -> a_jump
     | "call" "(" expr ")"                             -> u_call
     | "return"                                        -> u_return
     | "run" "(" expr ")"                              -> u_runrow
     | "stop"                                          -> a_stop
     | "end" ["take" expr]                             -> u_end

k_last: "last"
k_run: "run" expr ".." expr "base" expr "->" NAME ";"
k_field: "field" NAME ["when" expr] ["->" kout ("," kout)*] ";"
kout: NAME "=" expr ["when" expr]

table: "table" NAME (t_at | t_via) "stride" expr ["offset" expr] "{" rfield* "}"
t_at: "@" expr
t_via: "via" NAME
output: "output" NAME "@" expr "order" STRING ["copy" "to" expr] ";"
view: "view" NAME "@" expr "{" vfield* "}"
vfield: NAME "@" expr ";"
record: "record" NAME "@" expr "stride" expr "{" rfield* "}"
rfield: NAME ":" TYPE ["@" expr] ";"

proc: "proc" NAME "(" [param ("," param)*] ")" ("->" TYPE)? block
param: NAME ":" (TYPE | STREAM)
STREAM: "stream"

schedule: "schedule" sblock
sblock: "{" _sitem* "}"
_sitem: inst ";" | sif | sfor
sif: "if" expr sblock ("else" sblock)?
sfor: "for" NAME "in" iter sblock
inst: NAME ("[" expr "]")?
iter: expr ".." expr  -> irange
    | expr            -> ilist

invariant: "invariant" NAME ":" expr ";"
assume: "assume" expr ";"

block: "{" _stmt* "}"
_stmt: assign | let | next_let | next_set | if_ | match_ | while_ | for_ | call
     | return_ | finish | goto | in_ | stream | assert_ | native
     | labeled | group | fire | fire_block | react
fire: "fire" NAME ";"
fire_block: "fire" NAME block
react: "react" NAME "on" NAME "(" [expr ("," expr)*] ")" ["->" NAME] ";"
labeled: NAME ":" _stmt
group: "{" _stmt* "}"
assign: lval ASSIGNOP expr ";"
let: "let" NAME (":" TYPE)? "=" expr ";"
next_let: "let" NAME "=" "next" NAME ";"
next_set: lval ASSIGNOP "next" NAME ";"
if_: "if" expr block elif_* ("else" block)?
elif_: "elif" expr block
match_: "match" expr "{" marm* mdefault? "}"
marm: mpat ("," mpat)* ["if" expr] "=>" _mbody
mdefault: "_" "=>" _mbody
mpat: expr [".." expr]
_mbody: block | assign | call | next_set | return_ | finish | goto
while_: "while" expr "bound" INT block
for_: "for" NAME "in" iter block
call: NAME "(" [expr ("," expr)*] ")" ";"
return_: "return" [expr] ";"
finish: "finish" ";"
goto: "goto" NAME ";"
in_: "in" NAME "{" arm+ "}"
arm: NAME "=>" block
stream: "stream" NAME "=" expr "@" expr ("grammar" gsel ("," gsel)*)? ";"
gsel: STRING ("if" expr)?
assert_: "assert" expr ";"
native: "native" expr "(" [narg ("," narg)*] ")" "resumes" expr ";"
narg: NAME "=" expr

lval: NAME                 -> lname
    | NAME "[" expr "]"    -> lindex
    | "mem" "[" expr "]"   -> lmem
    | NAME "." NAME        -> lattr
    | NAME "[" expr "]" "." NAME -> linst
    | NAME "[" expr "]" "[" expr "]" "." NAME -> lrow

ASSIGNOP.3: ":=" | "+=" | "-=" | "&=" | "|=" | "^=" | "<<=" | ">>="

?expr: lor
?lor: land ("||" land)*         -> lor_
?land: lnot ("&&" lnot)*        -> land_
?lnot: "!" lnot                 -> not_
     | cmp
?cmp: bor (CMPOP bor)?          -> cmp_
?bor: bxor ("|" bxor)*          -> bor_
?bxor: band ("^" band)*         -> bxor_
?band: shift ("&" shift)*       -> band_
?shift: sum (SHOP sum)*         -> shift_
?sum: prod (ADDOP prod)*        -> sum_
?prod: unary (MULOP unary)*     -> prod_
?unary: "~" unary               -> inv_
      | "-" unary               -> neg_
      | atom
?atom: INT                      -> num
     | "true"                   -> true_
     | "false"                  -> false_
     | NAME                     -> name
     | NAME "[" expr "]"        -> index
     | NAME "[" expr "]" "." NAME -> inst_attr
     | NAME "[" expr "]" "[" expr "]" "." NAME -> row_attr
     | NAME "." NAME            -> attr
     | NAME "." NAME "." NAME   -> attr2
     | "mem" "[" expr "]"       -> mem
     | "mem16" "[" expr "]"     -> mem16
     | NAME "(" [expr ("," expr)*] ")" -> func
     | "(" expr ")"

CMPOP: "==" | "!=" | "<=" | ">=" | "<" | ">"
SHOP.2: "<<" | ">>"
MULOP: "*" | "/" | "%"
ADDOP: "+" | "-"
TYPE.2: /u(?:8|9|1[0-6])(?![A-Za-z0-9_])/ | "bool" | "ptr"
INT: /0x[0-9a-fA-F]+/ | /0b[01]+/ | /[0-9]+/
STRING: /"[^"]*"/

%import common.CNAME -> NAME
%import common.WS
%ignore WS
COMMENT: /\/\/[^\n]*/
%ignore COMMENT
