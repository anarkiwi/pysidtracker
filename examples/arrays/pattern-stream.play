// A pattern stream and an orderlist as index-addressed lists. The binder lays every pattern end to
// end in one list with the index each starts at, and each voice's orderlist at its own index; the
// spec reads both in place, and a pattern ends at a 0x7F note.
spec pattern_stream;
layout { w: addr; order_start: byte; pattern_bytes, pattern_first, order_bytes: list; }
cell ordpos: u8 @ L.w;
cell curptn: u8 @ L.w + 1;
cell ptnpos: u8 @ L.w + 2;
cell gap: u8 @ L.w + 3;
cell curnote: u8 @ L.w + 4;
cell curinst: u8 @ L.w + 5;
cell curfx: u8 @ L.w + 6;
event pattern_end: tick;
state pattern_bytes: u8[] ro = L.pattern_bytes;
state pattern_first: u16[] ro = L.pattern_first;
state order_bytes: u8[] ro = L.order_bytes;
state seqt: u16 = L.order_start;

table orderlist in order_bytes via seqt stride 1 { b: u8; }

cursor pattern { stream in pattern_bytes @ pattern_first[curptn]; pos ptnpos;
  on row next; on pattern_end reset;
  run 0xF0..0xF7 base 0xF0 -> gap;
  field note -> curnote = note & 0x7F;
  field inst when neg(note) -> curinst = inst & 0x7F;
  field fx when neg(inst) -> curfx = fx;
}

handler last_row on row { if curnote == 0x7F { fire pattern_end; } }

handler next_pattern on pattern_end {
  ordpos += 1;
  if orderlist[ordpos].b == 0xFF { ordpos := 0; }
  curptn := orderlist[ordpos].b;
}

machine player { step { fire row; } }
schedule { player; }
