      sid[V1_PW_LO] := out_v1_pw_lo;
    }
    if wrote_v1_pw_hi {
      sid[V1_PW_HI] := out_v1_pw_hi;
    }
    if wrote_v2_freq_lo {
      sid[V2_FREQ_LO] := out_v2_freq_lo;
    }
    if wrote_v2_freq_hi {
      sid[V2_FREQ_HI] := out_v2_freq_hi;
    }
    if wrote_v2_pw_lo {
      sid[V2_PW_LO] := out_v2_pw_lo;
    }
    if wrote_v2_pw_hi {
      sid[V2_PW_HI] := out_v2_pw_hi;
    }
    zp_lo := lo(zp_saved);
    zp_hi := hi(zp_saved);
  }
}

schedule { sidwizard_ordered; }
