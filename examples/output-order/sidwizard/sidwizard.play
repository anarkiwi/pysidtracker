    let hi_2: u8 = 0;
    let lo_2: u8 = 0;
    let y: u8 = 0;
    let y_2: u8 = 0;
    let a_3: u8 = 0;
    let a_4: u8 = 0;
    let a_5: u8 = 0;
    let a_6: u8 = 0;
    let advance: bool = false;
    let c1: bool = false;
    let c1_2: bool = false;
    let c1_3: bool = false;
