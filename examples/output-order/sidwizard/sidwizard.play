      voice2_tmppos := next_pos;
    } elif ((((voice2_spdcnt ^ tempo) & (voice2_spdcnt ^ diff)) & 0x80) != 0) {
      voice2_spdcnt := 0;
      voice2_tmppos := voice2_tmpbase;
    }
    let ticks: u8 = voice2_spdcnt;
