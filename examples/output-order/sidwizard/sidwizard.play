    let c_5: bool = false;
    let chord: bool = false;
    let cw: bool = false;
    let d: u8 = 0;
    let diff_hi: u8 = 0;
    let e1: u8 = 0;
    let e: u8 = 0;
    let fine: u8 = 0;
    let hi_3: u8 = 0;
    let hi_step: u8 = 0;
    let i: u8 = 0;
    let k: u8 = 0;
    let lo_3: u8 = 0;
    let lo_4: u8 = 0;
    let lo_5: u8 = 0;
    let note: u8 = 0;
    let pitch: u8 = 0;
    let rows: bool = false;
    let set: bool = false;
    let setwave: bool = false;
    let start: u8 = 0;
    let step_2: u8 = 0;
    let step_3: u8 = 0;
    let target: u8 = 0;
    let target_2: u8 = 0;
    let target_3: u8 = 0;
    let wave: u8 = 0;
    let y_3: u8 = 0;
    let y_4: u8 = 0;
    let y_5: u8 = 0;
    let y_6: u8 = 0;
    let y_7: u8 = 0;
    let y_8: u8 = 0;
    let relptch: bool = false;
    let wftable: bool = false;
    let ret_filtprg: bool = false;
    let ret_hardrst: bool = false;
    let ret_wftable: bool = false;
    if (ticks == 0) {
      lo_2 := ptnl1[voice2_curptn];
      zp_lo := lo_2;
      hi_2 := ptnh1[voice2_curptn];
      zp_hi := hi_2;
      voice2_curifx := 0;
      voice2_curfx2 := 0;
      mainvol := seqvolu;
      if (voice2_seqtempo != 0) {
        a_2 := (voice2_seqtempo | 0x80);
        mem[0x2ee8] := a_2;
        voice2_tmpbase := 6;
        voice2_tmppos := 6;
        voice2_seqtempo := 0;
      }
      let note_col_base: u16 = word(zp_lo, zp_hi);
      let inst_col_base: u16 = word(zp_lo, zp_hi);
      let fx_col_base: u16 = word(zp_lo, zp_hi);
      let value_col_base: u16 = word(zp_lo, zp_hi);
      let row: u8 = 0;
      if (voice2_packcnt != 0) {
        voice2_packcnt := (voice2_packcnt - 1);
      } else {
        row := mem[(note_col_base + u16((voice2_ptnpos + 0)))];
        if ((0x70 <= row) && (row < 0x78)) {
          voice2_packcnt := (row - 0x6f);
          row := 0;
        }
      }
      let cond: bool = !((row & 0x80) != 0);
      let cond_2: bool = false;
      let cond_3: bool = false;
      if !((row & 0x80) != 0) {
        voice2_curnot := row;
      } else {
        voice2_curnot := (row & 0x7f);
        let ins: u8 = mem[(inst_col_base + u16((voice2_ptnpos + 1)))];
        cond_3 := !((ins & 0x80) != 0);
        if !((ins & 0x80) != 0) {
          voice2_curifx := ins;
        } else {
          voice2_curifx := (ins & 0x7f);
          let fx: u8 = mem[(fx_col_base + u16((voice2_ptnpos + 2)))];
          voice2_curfx2 := fx;
          cond_2 := ((fx & 0xe0) == 0);
          if ((fx & 0xe0) == 0) {
            voice2_curval := mem[(value_col_base + u16((voice2_ptnpos + 3)))];
          }
        }
      }
      voice2_ptnpos := (voice2_ptnpos + ite(cond, 0, ite(cond_3, 1, ite(cond_2, 3, 2))));
      ret_hardrst := false;
      if ((voice2_curnot == 0) || (0x60 <= voice2_curnot)) {
        if !(voice2_curins == 0) {
          lo_2 := insl1[voice2_curins];
          zp_lo := lo_2;
          hi_2 := insh1[voice2_curins];
          zp_hi := hi_2;
          if (voice2_slidevib == 0) {
            c_5 := ((voice2_freqmodl + voice2_videlcnt) < voice2_freqmodl);
            voice2_freqmodl := (voice2_freqmodl + voice2_videlcnt);
            if c_5 {
              voice2_freqmodh := (voice2_freqmodh + 1);
            }
            a_6 := voice2_vibracnt;
            if (voice2_vibracnt == 0) {
              a_6 := voice2_vibfrequ;
            }
            a_6 := (a_6 - 1);
            voice2_vibracnt := a_6;
            if ((a_6 << 1) < voice2_vibfrequ) {
              lo_3 := voice2_freqlo;
              voice2_freqlo := ((voice2_freqlo + voice2_freqmodl) + 0);
              c1_3 := ((lo_3 + voice2_freqmodl) < lo_3);
              voice2_freqhi := ((voice2_freqhi + voice2_freqmodh) + u8(c1_3));
            } else {
              lo_4 := voice2_freqlo;
              voice2_freqlo := ((voice2_freqlo - voice2_freqmodl) - 0);
              c1_4 := !(lo_4 < voice2_freqmodl);
              voice2_freqhi := ((voice2_freqhi - voice2_freqmodh) - u8(!c1_4));
            }
          } elif !((voice2_slidevib & 0x80) != 0) {
            if ((voice2_videlcnt & 0x80) != 0) {
              a_6 := voice2_vibracnt;
              if (voice2_vibracnt == 0) {
                a_6 := voice2_vibfrequ;
              }
              a_6 := (a_6 - 1);
              voice2_vibracnt := a_6;
              if ((a_6 << 1) < voice2_vibfrequ) {
                lo_3 := voice2_freqlo;
                voice2_freqlo := ((voice2_freqlo + voice2_freqmodl) + 0);
                c1_3 := ((lo_3 + voice2_freqmodl) < lo_3);
                voice2_freqhi := ((voice2_freqhi + voice2_freqmodh) + u8(c1_3));
              } else {
                lo_4 := voice2_freqlo;
                voice2_freqlo := ((voice2_freqlo - voice2_freqmodl) - 0);
                c1_4 := !(lo_4 < voice2_freqmodl);
                voice2_freqhi := ((voice2_freqhi - voice2_freqmodh) - u8(!c1_4));
              }
            } else {
              voice2_videlcnt := (voice2_videlcnt - 1);
            }
          } elif (voice2_slidevib == 0x82) {
            lo_4 := voice2_freqlo;
            voice2_freqlo := ((voice2_freqlo - voice2_freqmodl) - 0);
            c1_4 := !(lo_4 < voice2_freqmodl);
            voice2_freqhi := ((voice2_freqhi - voice2_freqmodh) - u8(!c1_4));
          } elif (((voice2_slidevib - 0x82) & 0x80) != 0) {
            lo_3 := voice2_freqlo;
            voice2_freqlo := ((voice2_freqlo + voice2_freqmodl) + 0);
            c1_3 := ((lo_3 + voice2_freqmodl) < lo_3);
            voice2_freqhi := ((voice2_freqhi + voice2_freqmodh) + u8(c1_3));
          } else {
            lo_5 := freqtbl[voice2_dpitch];
            storfrl := ((lo_5 - voice2_freqlo) - 0);
            c1_5 := !(lo_5 < voice2_freqlo);
            hi_3 := freqtbh[voice2_dpitch];
            diff_hi := ((hi_3 - voice2_freqhi) - u8(!c1_5));
            c2 := !((hi_3 < voice2_freqhi) || (!c1_5 && (hi_3 == voice2_freqhi)));
            if c2 {
              c3_2 := !(storfrl < voice2_freqmodl);
              c4 := !((diff_hi < voice2_freqmodh) || (!c3_2 && (diff_hi == voice2_freqmodh)));
              if c4 {
                lo_3 := voice2_freqlo;
                voice2_freqlo := ((voice2_freqlo + voice2_freqmodl) + 1);
                c1_3 := (((lo_3 + voice2_freqmodl) < lo_3) || ((lo_3 + voice2_freqmodl) == 0xff));
                voice2_freqhi := ((voice2_freqhi + voice2_freqmodh) + u8(c1_3));
              } else {
                voice2_freqlo := freqtbl[voice2_dpitch];
                voice2_freqhi := freqtbh[voice2_dpitch];
              }
            } else {
              c3 := ((storfrl + voice2_freqmodl) < storfrl);
              if (((diff_hi + voice2_freqmodh) < diff_hi) || (c3 && ((diff_hi + voice2_freqmodh) == 0xff))) {
                voice2_freqlo := freqtbl[voice2_dpitch];
                voice2_freqhi := freqtbh[voice2_dpitch];
              } else {
                lo_4 := voice2_freqlo;
                voice2_freqlo := ((voice2_freqlo - voice2_freqmodl) - 1);
                c1_4 := !((lo_4 < voice2_freqmodl) || (lo_4 == voice2_freqmodl));
                voice2_freqhi := ((voice2_freqhi - voice2_freqmodh) - u8(!c1_4));
              }
            }
          }
          ret_filtprg := false;
          if !(0xe != fltctrl) {
            y_3 := fltposi;
            a_3 := mem[(word(zp_lo, zp_hi) + u16(fltposi))];
            if !((a_3 & 0x80) != 0) {
              y_3 := (fltposi + 1);
              if (a_3 == cwepcnt) {
                y_4 := (y_3 + 1);
                a_4 := mem[(word(zp_lo, zp_hi) + u16(y_4))];
                if (((a_4 & 0x80) != 0) && (a_4 < 0x90)) {
                  fswitch := (a_4 & 0xf);
                  a_4 := 0;
                }
                ckbdtrk := a_4;
                y := (y_4 + 1);
                fltposi := y;
                cwepcnt := 0;
                ret_filtprg := true;
              } else {
                cwepcnt := (cwepcnt + 1);
                step_2 := mem[(word(zp_lo, zp_hi) + u16(y_3))];
                if !((step_2 & 0x80) != 0) {
                  fine := ((step_2 & 7) + ctflgho);
                  c := (8 <= fine);
                  ctflgho := (fine & 7);
                  hi_step := (mem[(word(zp_lo, zp_hi) + u16(y_3))] >> 3);
                } else {
                  c := (((step_2 | 0xf8) + ctflgho) < (step_2 | 0xf8));
                  ctflgho := (((step_2 | 0xf8) + ctflgho) & 7);
                  hi_step := (((mem[(word(zp_lo, zp_hi) + u16(y_3))] ^ 0xff) >> 3) ^ 0xff);
                }
                ctfhgho := ((hi_step + ctfhgho) + u8(c));
                ret_filtprg := true;
              }
            }
            if !ret_filtprg {
              if (a_3 == 0xfe) {
                y_3 := (y_3 + 1);
                target := mem[(word(zp_lo, zp_hi) + u16(y_3))];
                if (target == fltposi) {
                  ret_filtprg := true;
                } else {
                  y_3 := target;
                  a_3 := mem[(word(zp_lo, zp_hi) + u16(target))];
                  if !((a_3 & 0x80) != 0) {
                    fltposi := target;
                    cwepcnt := 0;
                    ret_filtprg := true;
                  }
                }
              } elif (0xfe < a_3) {
                ret_filtprg := true;
              }
              if !ret_filtprg {
                fltband := (a_3 & 0x70);
                resonib := (a_3 << 4);
                y_3 := (y_3 + 1);
                ctfhgho := mem[(word(zp_lo, zp_hi) + u16(y_3))];
                ctflgho := 0;
                y_4 := (y_3 + 1);
                a_4 := mem[(word(zp_lo, zp_hi) + u16(y_4))];
                if (((a_4 & 0x80) != 0) && (a_4 < 0x90)) {
                  fswitch := (a_4 & 0xf);
                  a_4 := 0;
                }
                ckbdtrk := a_4;
                y := (y_4 + 1);
                fltposi := y;
                cwepcnt := 0;
              }
            }
          }
          y_5 := voice2_pwtpos;
          a_5 := mem[(word(zp_lo, zp_hi) + u16(voice2_pwtpos))];
          advance := false;
          set := false;
