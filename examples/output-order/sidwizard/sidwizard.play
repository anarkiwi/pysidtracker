                voice2_freqlo := ((voice2_freqlo - voice2_freqmodl) - 0);
                c1_4 := !(lo_4 < voice2_freqmodl);
                voice2_freqhi := ((voice2_freqhi - voice2_freqmodh) - u8(!c1_4));
              }
            } else {
              voice2_videlcnt := (voice2_videlcnt - 1);
            }
          } elif (voice2_slidevib == 0x82) {
            lo_4 := voice2_freqlo;
            voice2_freqlo := ((voice2_freqlo - voice2_freqmodl) - 0);
            c1_4 := !(lo_4 < voice2_freqmodl);
            voice2_freqhi := ((voice2_freqhi - voice2_freqmodh) - u8(!c1_4));
          } elif (((voice2_slidevib - 0x82) & 0x80) != 0) {
