        }
      }
      voice2_ptnpos := (voice2_ptnpos + ite(cond_125, 0, ite(cond_127, 1, ite(cond_126, 3, 2))));
      ret_hardrst := false;
      cond_18 := ((voice2_curnot == 0) || (0x60 <= voice2_curnot));
      if ((voice2_curnot == 0) || (0x60 <= voice2_curnot)) {
