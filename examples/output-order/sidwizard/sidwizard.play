        mem[0x2ee8] := a_2;
        voice2_tmpbase := 6;
        voice2_tmppos := 6;
        voice2_seqtempo := 0;
      }
      let note_col_base: u16 = word(zp_lo, zp_hi);
      let inst_col_base: u16 = word(zp_lo, zp_hi);
      let fx_col_base: u16 = word(zp_lo, zp_hi);
      let value_col_base: u16 = word(zp_lo, zp_hi);
      let row: u8 = 0;
      if (voice2_packcnt != 0) {
        voice2_packcnt := (voice2_packcnt - 1);
      } else {
        row := mem[(note_col_base + u16((voice2_ptnpos + 0)))];
        if ((0x70 <= row) && (row < 0x78)) {
          voice2_packcnt := (row - 0x6f);
          row := 0;
        }
      }
      let cond_125: bool = !((row & 0x80) != 0);
      let cond_126: bool = false;
