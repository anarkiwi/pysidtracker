        let a_7: u8 = 0;
        let l: u8 = 0;
        let lo_2: u8 = 0;
        let lo_3: u8 = 0;
        if (ka == 0x7b) {
          if !ite(!((sleft[ky] & 0x80) != 0), (temp1 == 0), (csresty == 0)) {
            if (0 < chan0_vibdelay) {
              chan0_vibdelay := (chan0_vibdelay - 1);
            } else {
              l := sleft[y_3];
              if !((l & 0x80) != 0) {
                temp2 := 0;
              }
              speedcmp := (l & 0x7f);
              a_7 := chan0_vibtime;
              if (!((chan0_vibtime & 0x80) != 0) && (speedcmp < chan0_vibtime)) {
                a_7 := (chan0_vibtime ^ 0xff);
