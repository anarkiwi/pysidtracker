        } else {
          cscount := sright[ky];
          csresty := ky;
          temp1 := (flo1[chan0_lastnote] - flo[chan0_lastnote]);
          let hi_2: u8 = ((fhi1[chan0_lastnote] - fhi[chan0_lastnote]) - ite(!(flo1[chan0_lastnote] < flo[chan0_lastnote]), 0, 1));
          let count: u8 = cscount;
          while (count != 0) bound 256 {
            temp1 := ((temp1 >> 1) | ((hi_2 & 1) << 7));
            hi_2 := (hi_2 >> 1);
            count := (count - 1);
          }
          y_3 := csresty;
