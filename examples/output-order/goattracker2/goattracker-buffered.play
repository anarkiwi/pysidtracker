        } elif (j_2 == 0x4a) {
          filter0_cutoff := chan0_newparam;
        } elif (j_2 == 0x4e) {
          masterfader := chan0_newparam;
        } elif (j_2 == 0x52) {
          mem[0x147d] := sleft[chan0_newparam];
          mem[0x147e] := sright[chan0_newparam];
          mem[0x14ab] := 0;
          mem[0x14b2] := 0;
          mem[0x14b9] := 0;
        } elif (j_2 == 0x63) {
          if ((chan0_newparam & 0x80) != 0) {
            mem[0x14ab] := (chan0_newparam & 0x7f);
          } else {
            mem[0x14ab] := chan0_newparam;
            mem[0x14b2] := chan0_newparam;
            mem[0x14b9] := chan0_newparam;
          }
        }
        k := kn;
      }
      if (k == 2) {
        k := 4;
        if !(chan0_waveptr == 0) {
          let a_5: u8 = wave1[chan0_waveptr];
          let cond_3: bool = (a_5 < 0x10);
          let a_6: u8 = 0;
          let cond_4: bool = false;
          let cond_5: bool = false;
          if (a_5 < 0x10) {
            cond_5 := (a_5 != chan0_wavetime);
            if (a_5 != chan0_wavetime) {
              let c: bool = (chan0_wavetime <= a_5);
              chan0_wavetime := (chan0_wavetime + 1);
              cond_4 := (chan0_wavetime != 0);
