          let cond_2: bool = false;
          if (0xd0 <= a) {
            chan0_repeat := (chan0_repeat + 1);
            cond_2 := ((a - 0xd0) != chan0_repeat);
            if !((a - 0xd0) != chan0_repeat) {
              chan0_repeat := 0;
            }
          } else {
            chan0_pattnum := a;
          }
          if !ite(cond, cond_2, false) {
            ord_pos := (ord_pos + 1);
            chan0_songptr := ord_pos;
          }
        }
        ky := chan0_instr;
        chan0_gatetimer := i_gate[chan0_instr];
        if (chan0_newnote == 0) {
          k := 1;
          kn := 2;
        } else {
          chan0_note := (chan0_newnote - 0x60);
          chan0_fx := 0;
          chan0_newnote := 0;
          chan0_vibdelay := i_vibdelay[chan0_instr];
          chan0_param := i_vibparam[chan0_instr];
