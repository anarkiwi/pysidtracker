spec v0x_ordered;

const V0_FREQ_LO = 0;
const V0_FREQ_HI = 1;
const V0_CTRL = 4;
const V1_FREQ_LO = 7;
const V1_FREQ_HI = 8;
const V1_CTRL = 11;
const V2_FREQ_LO = 14;
const V2_FREQ_HI = 15;
const V2_CTRL = 18;

cell sid: u8[25] @ 0xd400 out;
cell ftab: u8[192] @ 0x121f ro;
cell subtab_hi: u8[128] @ 0x1383 ro;
cell subtab_lo: u8[128] @ 0x137e ro;
cell tempo: u8 @ 0x12f4;
cell voice0_cur_hi: u8 @ 0x12e2;
cell voice0_cur_lo: u8 @ 0x12df;
cell voice0_depth: u8 @ 0x1308;
cell voice0_freq_hi: u8 @ 0x1302;
cell voice0_freq_lo: u8 @ 0x12ff;
cell voice0_gate_flag: u8 @ 0x12fc;
cell voice0_gate_reload: u8 @ 0x12f6;
cell voice0_save_hi: u8 @ 0x12ee;
cell voice0_save_lo: u8 @ 0x12eb;
cell voice0_transpose: u8 @ 0x1305;
cell voice1_cur_hi: u8 @ 0x12e3;
cell voice1_cur_lo: u8 @ 0x12e0;
cell voice1_depth: u8 @ 0x1309;
cell voice1_freq_hi: u8 @ 0x1303;
cell voice1_freq_lo: u8 @ 0x1300;
cell voice1_gate_flag: u8 @ 0x12fd;
cell voice1_gate_reload: u8 @ 0x12f7;
cell voice1_save_hi: u8 @ 0x12ef;
cell voice1_save_lo: u8 @ 0x12ec;
cell voice1_transpose: u8 @ 0x1306;
cell voice2_cur_hi: u8 @ 0x12e4;
cell voice2_cur_lo: u8 @ 0x12e1;
cell voice2_depth: u8 @ 0x130a;
cell voice2_freq_hi: u8 @ 0x1304;
cell voice2_freq_lo: u8 @ 0x1301;
cell voice2_gate_flag: u8 @ 0x12fe;
cell voice2_gate_reload: u8 @ 0x12f8;
cell voice2_save_hi: u8 @ 0x12f0;
cell voice2_save_lo: u8 @ 0x12ed;
cell voice2_transpose: u8 @ 0x1307;
cell zp_hi: u8 @ 0x00fc scratch;
cell zp_lo: u8 @ 0x00fb scratch;

machine v0x_ordered {
  step {
    let lo_2: u8 = zp_lo;
    let hi_2: u8 = zp_hi;
    zp_lo := voice2_cur_lo;
    zp_hi := voice2_cur_hi;
    if ((mem[0x12fb] & 0x80) != 0) {
      let bv: u8 = 0;
      mem[0x12fb] := voice2_gate_reload;
      let st: u8 = 0;
      if (voice2_depth == 0) {
        st := 3;
      } else {
        st := 5;
      }
      let c: u8 = 0;
      let cy: bool = false;
      let idx: u8 = 0;
      while (st != 0) bound 4094 {
        if (st == 1) {
          mem[0x12fb] := voice2_gate_reload;
          st := 2;
        } elif (st == 2) {
          if (voice2_depth == 0) {
            st := 3;
          } else {
            st := 5;
          }
        } elif (st == 3) {
          bv := mem[(word(zp_lo, zp_hi) + 0)];
          if (bv < 0x80) {
            voice2_save_lo := zp_lo;
            voice2_save_hi := zp_hi;
            zp_lo := subtab_lo[bv];
            zp_hi := subtab_hi[bv];
            voice2_depth := (voice2_depth + 1);
            st := 5;
          } elif ((bv & 0xe0) != 0x80) {
            st := 4;
          } else {
            voice2_transpose := (((bv & 0x1f) - 0xc) << 1);
            zp_lo := (zp_lo + 1);
            if (zp_lo == 0) {
              zp_hi := (zp_hi + 1);
            }
            st := 3;
          }
        } elif (st == 4) {
          zp_lo := 0x15;
          zp_hi := 0x13;
          st := 1;
        } elif (st == 5) {
          bv := mem[(word(zp_lo, zp_hi) + 0)];
          if (0x80 <= bv) {
            st := 8;
          } else {
            c := (bv << 1);
            if (c == 0) {
              st := 6;
            } elif (c == 0xfe) {
              st := 7;
            } else {
              idx := ((c + 0) + voice2_transpose);
              cy := ((ftab[idx] + 8) < ftab[idx]);
              voice2_freq_lo := (ftab[idx] + 8);
              voice2_freq_hi := (ftab[(u16(idx) + 1)] + u8(cy));
              voice2_gate_flag := 0;
              st := 0xb;
            }
          }
        } elif (st == 6) {
          sid[V2_CTRL] := 0x10;
          st := 7;
        } elif (st == 7) {
          voice2_gate_flag := 1;
          st := 0xb;
        } elif (st == 8) {
          if ((bv & 0xf0) == 0x80) {
            mem[0x12fb] := (bv & 0xf);
            voice2_gate_reload := (bv & 0xf);
            st := 0xa;
          } else {
            st := 9;
          }
        } elif (st == 9) {
          voice2_depth := 0;
          zp_lo := voice2_save_lo;
          zp_hi := voice2_save_hi;
          st := 0xa;
        } elif (st == 0xa) {
          zp_lo := (zp_lo + 1);
          if (zp_lo == 0) {
            zp_hi := (zp_hi + 1);
          }
          st := 2;
        } else {
          zp_lo := (zp_lo + 1);
          if (zp_lo == 0) {
            zp_hi := (zp_hi + 1);
          }
          st := 0;
        }
      }
    } else {
      voice2_gate_flag := 1;
    }
    if (voice2_gate_flag == 0) {
      sid[V2_CTRL] := 0x21;
    }
    voice2_cur_lo := zp_lo;
    voice2_cur_hi := zp_hi;
    zp_lo := voice1_cur_lo;
    zp_hi := voice1_cur_hi;
    if ((mem[0x12fa] & 0x80) != 0) {
      let bv_2: u8 = 0;
      mem[0x12fa] := voice1_gate_reload;
      let st_2: u8 = 0;
      if (voice1_depth == 0) {
        st_2 := 3;
      } else {
        st_2 := 5;
      }
      let c_2: u8 = 0;
      let cy_2: bool = false;
      let idx_2: u8 = 0;
      while (st_2 != 0) bound 4094 {
        if (st_2 == 1) {
          mem[0x12fa] := voice1_gate_reload;
          st_2 := 2;
        } elif (st_2 == 2) {
          if (voice1_depth == 0) {
            st_2 := 3;
          } else {
            st_2 := 5;
          }
        } elif (st_2 == 3) {
          bv_2 := mem[(word(zp_lo, zp_hi) + 0)];
          if (bv_2 < 0x80) {
            voice1_save_lo := zp_lo;
            voice1_save_hi := zp_hi;
            zp_lo := subtab_lo[bv_2];
            zp_hi := subtab_hi[bv_2];
            voice1_depth := (voice1_depth + 1);
            st_2 := 5;
          } elif ((bv_2 & 0xe0) != 0x80) {
            st_2 := 4;
          } else {
            voice1_transpose := (((bv_2 & 0x1f) - 0xc) << 1);
            zp_lo := (zp_lo + 1);
            if (zp_lo == 0) {
              zp_hi := (zp_hi + 1);
            }
            st_2 := 3;
          }
        } elif (st_2 == 4) {
          zp_lo := 0xb;
          zp_hi := 0x13;
          st_2 := 1;
        } elif (st_2 == 5) {
          bv_2 := mem[(word(zp_lo, zp_hi) + 0)];
          if (0x80 <= bv_2) {
            st_2 := 8;
          } else {
            c_2 := (bv_2 << 1);
            if (c_2 == 0) {
              st_2 := 6;
            } elif (c_2 == 0xfe) {
              st_2 := 7;
            } else {
              idx_2 := ((c_2 + 0) + voice1_transpose);
              cy_2 := ((ftab[idx_2] + 0) < ftab[idx_2]);
              voice1_freq_lo := (ftab[idx_2] + 0);
              voice1_freq_hi := (ftab[(u16(idx_2) + 1)] + u8(cy_2));
              voice1_gate_flag := 0;
              st_2 := 0xb;
            }
          }
        } elif (st_2 == 6) {
          sid[V1_CTRL] := 0x10;
          st_2 := 7;
        } elif (st_2 == 7) {
          voice1_gate_flag := 1;
          st_2 := 0xb;
        } elif (st_2 == 8) {
          if ((bv_2 & 0xf0) == 0x80) {
            mem[0x12fa] := (bv_2 & 0xf);
            voice1_gate_reload := (bv_2 & 0xf);
            st_2 := 0xa;
          } else {
            st_2 := 9;
          }
        } elif (st_2 == 9) {
          voice1_depth := 0;
          zp_lo := voice1_save_lo;
          zp_hi := voice1_save_hi;
          st_2 := 0xa;
        } elif (st_2 == 0xa) {
          zp_lo := (zp_lo + 1);
          if (zp_lo == 0) {
            zp_hi := (zp_hi + 1);
          }
          st_2 := 2;
        } else {
          zp_lo := (zp_lo + 1);
          if (zp_lo == 0) {
            zp_hi := (zp_hi + 1);
          }
          st_2 := 0;
        }
      }
    } else {
      voice1_gate_flag := 1;
    }
    if (voice1_gate_flag == 0) {
      sid[V1_CTRL] := 0x21;
    }
    voice1_cur_lo := zp_lo;
    voice1_cur_hi := zp_hi;
    zp_lo := voice0_cur_lo;
    zp_hi := voice0_cur_hi;
    if ((mem[0x12f9] & 0x80) != 0) {
      let bv_3: u8 = 0;
      mem[0x12f9] := voice0_gate_reload;
      let st_3: u8 = 0;
      if (voice0_depth == 0) {
        st_3 := 3;
      } else {
        st_3 := 5;
      }
      let c_3: u8 = 0;
      let cy_3: bool = false;
      let idx_3: u8 = 0;
      while (st_3 != 0) bound 4094 {
        if (st_3 == 1) {
          mem[0x12f9] := voice0_gate_reload;
          st_3 := 2;
        } elif (st_3 == 2) {
          if (voice0_depth == 0) {
            st_3 := 3;
          } else {
            st_3 := 5;
          }
        } elif (st_3 == 3) {
          bv_3 := mem[(word(zp_lo, zp_hi) + 0)];
          if (bv_3 < 0x80) {
            voice0_save_lo := zp_lo;
            voice0_save_hi := zp_hi;
            zp_lo := subtab_lo[bv_3];
            zp_hi := subtab_hi[bv_3];
            voice0_depth := (voice0_depth + 1);
            st_3 := 5;
          } elif ((bv_3 & 0xe0) != 0x80) {
            st_3 := 4;
          } else {
            voice0_transpose := (((bv_3 & 0x1f) - 0xc) << 1);
            zp_lo := (zp_lo + 1);
            if (zp_lo == 0) {
              zp_hi := (zp_hi + 1);
            }
            st_3 := 3;
          }
        } elif (st_3 == 4) {
          zp_lo := 0x1e;
          zp_hi := 0x13;
          st_3 := 1;
        } elif (st_3 == 5) {
          bv_3 := mem[(word(zp_lo, zp_hi) + 0)];
          if (0x80 <= bv_3) {
            st_3 := 8;
          } else {
            c_3 := (bv_3 << 1);
            if (c_3 == 0) {
              st_3 := 6;
            } elif (c_3 == 0xfe) {
              st_3 := 7;
            } else {
              idx_3 := ((c_3 + 0) + voice0_transpose);
              cy_3 := ((ftab[idx_3] + 0) < ftab[idx_3]);
              voice0_freq_lo := (ftab[idx_3] + 0);
              voice0_freq_hi := (ftab[(u16(idx_3) + 1)] + u8(cy_3));
              voice0_gate_flag := 0;
              st_3 := 0xb;
            }
          }
        } elif (st_3 == 6) {
          sid[V0_CTRL] := 0x10;
          st_3 := 7;
        } elif (st_3 == 7) {
          voice0_gate_flag := 1;
          st_3 := 0xb;
        } elif (st_3 == 8) {
          if ((bv_3 & 0xf0) == 0x80) {
            mem[0x12f9] := (bv_3 & 0xf);
            voice0_gate_reload := (bv_3 & 0xf);
            st_3 := 0xa;
          } else {
            st_3 := 9;
          }
        } elif (st_3 == 9) {
          voice0_depth := 0;
          zp_lo := voice0_save_lo;
          zp_hi := voice0_save_hi;
          st_3 := 0xa;
        } elif (st_3 == 0xa) {
          zp_lo := (zp_lo + 1);
          if (zp_lo == 0) {
            zp_hi := (zp_hi + 1);
          }
          st_3 := 2;
        } else {
          zp_lo := (zp_lo + 1);
          if (zp_lo == 0) {
            zp_hi := (zp_hi + 1);
          }
          st_3 := 0;
        }
      }
    } else {
      voice0_gate_flag := 1;
    }
    if (voice0_gate_flag == 0) {
      sid[V0_CTRL] := 0x21;
    }
    sid[V0_FREQ_LO] := voice0_freq_lo;
    sid[V0_FREQ_HI] := voice0_freq_hi;
    sid[V1_FREQ_LO] := voice1_freq_lo;
    sid[V1_FREQ_HI] := voice1_freq_hi;
    sid[V2_FREQ_LO] := voice2_freq_lo;
    sid[V2_FREQ_HI] := voice2_freq_hi;
    voice0_cur_lo := zp_lo;
    voice0_cur_hi := zp_hi;
    tempo := (tempo - 1);
    if (tempo == 0) {
      tempo := 2;
      mem[0x12f9] := (mem[0x12f9] - 1);
      mem[0x12fa] := (mem[0x12fa] - 1);
      mem[0x12fb] := (mem[0x12fb] - 1);
    }
    zp_lo := lo_2;
    zp_hi := hi_2;
  }
}

schedule { v0x_ordered; }
