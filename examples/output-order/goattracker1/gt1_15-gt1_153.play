                    chan2_pulse := (chan2_pulse + hi(sum_5));
                    flip_3 := ite((i_phigh[chan2_instnum] <= chan2_pulse), 1, 0);
                  } else {
                    low_3 := ((chan2_pulsedir & 0xfe) - speed_5);
                    chan2_pulse := (chan2_pulse - ite(((chan2_pulsedir & 0xfe) < speed_5), 1, 0));
                    flip_3 := ite((i_plow[chan2_instnum] <= chan2_pulse), 1, 0);
                  }
                  chan2_pulsedir := (low_3 + flip_3);
                }
                t_9 := (chan2_wave & chan2_gate);
                sid[V2_CTRL] := t_9;
                sid[V2_FREQ_LO] := chan2_flo;
                sid[V2_FREQ_HI] := chan2_fhi;
                if cond_411 {
                  sid[V2_PW_LO] := (low_3 + flip_3);
                }
                if cond_411 {
                  sid[V2_PW_HI] := chan2_pulse;
                }
              }
            }
          }
        }
      }
    }
    chnloop := 0xff;
    zplo := lo_2;
    zphi := hi_2;
  }
}

schedule { gt1_15_ordered; }
